{
  "manifest_version": 2,
  "name": "NeoInbox",
  "description": "Google Inbox, reimplemented as a Thunderbird extension",
  "browser_specific_settings": {
    "gecko": {
      "id": "neoinbox@freakified.dev",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "64": "icon.svg"
  },
  "browser_action": {
    "default_title": "Open NeoInbox",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "compose",
    "compose.send",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesDelete",
    "accountsRead",
    "addressBooks",
    "storage",
    "alarms",
    "tabs"
  ],
  "optional_permissions": [
    "*://*/*"
  ]
}
