{
  "name": "neoinbox",
  "version": "1.0.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "Google Inbox reimplemented as a Thunderbird MailExtension.",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "package": "vite build && rm -f neoinbox.xpi && cd dist && zip -qr ../neoinbox.xpi .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.eval.json",
    "harness": "vite --port 5199 --strictPort",
    "site": "vite --mode site --port 5200 --strictPort",
    "build:site": "vite build --mode site",
    "shot": "node scripts/shot.mjs",
    "eval": "vitest run --config vitest.eval.config.ts",
    "samples:receive": "node scripts/sample-server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-rounded": "^5.2.43",
    "@fontsource/roboto": "^5.2.10",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "framer-motion": "^12.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/thunderbird-webext-browser": "^127.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
